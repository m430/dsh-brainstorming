{
  "name": "dsh-brainstorming",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "头脑风暴：无限画布、AI 提问/意图分析/调研，适用于 DeepSeek Harness。",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CHANGELOG.zh.md",
    "LICENSES/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "main": "./lib/host/index.js",
  "types": "./lib/host/index.d.ts",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.25.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Andy Zheng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m430/dsh-brainstorming.git"
  },
  "homepage": "https://github.com/m430/dsh-brainstorming#readme",
  "bugs": {
    "url": "https://github.com/m430/dsh-brainstorming/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "brainstorming",
    "mind-map",
    "ai",
    "plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.host.json && node scripts/build-client.mjs",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "node scripts/build-client.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:host": "tsc -p tsconfig.host.json --watch --preserveWatchOutput",
    "dev:client": "node scripts/build-client.mjs --watch",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json",
    "check": "npm run typecheck && node --check lib/client.js",
    "verify-pack": "node scripts/verify-pack.mjs",
    "prepare": "node scripts/ensure-built.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11",
    "dsh": ">=0.1.0-0"
  },
  "packageManager": "pnpm@11.28.5"
}
